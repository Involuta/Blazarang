	{
		float __input_range = n_in4p2 - n_in4p1;
		float __output_range = n_in4p4 - n_in4p3;
		n_out4p0 = n_in4p3 + __output_range * ((n_out3p1 - n_in4p1) / __input_range);
	}


// Texture2D:2
	vec4 n_out2p0 = textureLod(tex_frg_2, UV, n_out4p0);
