	float n_out7p4 = n_out7p0.a;


// FloatOp:8
	float n_out8p0 = n_out6p0 * n_out7p4;


// Output:0
	ALBEDO = vec3(n_out9p0.xyz);
	ALPHA = n_out8p0;


}
