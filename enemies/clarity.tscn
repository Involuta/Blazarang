, 255, 255, 255, 63, 39, 42, 214, 63, 253, 126, 106, 63, 117, 208, 129, 187, 255, 127, 255, 127, 255, 255, 255, 63, 39, 42, 214, 63, 226, 79, 13, 63, 189, 209, 129, 187, 255, 127, 255, 127, 255, 255, 255, 63, 149, 208, 173, 63, 72, 139, 140, 63, 140, 208, 129, 187, 255, 127, 255, 127, 255, 255, 255, 63, 39, 42, 214, 191, 75, 12, 130, 191, 183, 216, 129, 187, 255, 127, 255, 127, 255, 255, 255, 63, 39, 42, 214, 191, 126, 233, 38, 191, 111, 215, 129, 187, 255, 127, 255, 127, 255, 255, 255, 63, 149, 208, 173, 191, 22, 88, 153, 191, 160, 216, 129, 187, 255, 127, 255, 127, 255, 255, 255, 63, 183, 231, 215, 179, 48, 178, 253, 191, 99, 218, 129, 187, 255, 127, 255, 127, 255, 255, 255, 63, 68, 102, 161, 190, 103, 102, 230, 191, 251, 217, 129, 187, 255, 127, 255, 127, 255, 255, 255, 63, 62, 102, 161, 62, 103, 102, 230, 191, 132, 217, 129, 187, 255, 127, 255, 127, 255, 255, 255, 63, 189, 44, 214, 51, 97, 229, 240, 63, 201, 206, 129, 187, 255, 127, 255, 127, 255, 255, 255, 63, 71, 102, 161, 62, 153, 153, 217, 63, 49, 207, 129, 187, 255, 127, 255, 127, 255, 255, 255, 63, 62, 102, 161, 190, 153, 153, 217, 63, 168, 207, 129, 187, 255, 127, 255, 127, 255, 255, 255, 63)
